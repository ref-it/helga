{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-sqlite3": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "^3.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "kovah/laravel-socialite-oidc": "^0.8.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^3.0",
        "livewire/flux": "^2.14",
        "livewire/flux-pro": "^2.14",
        "livewire/livewire": "^4.0",
        "mews/captcha": "^3.4",
        "mews/purifier": "^3.4",
        "outhebox/blade-flags": "^1.7"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.28",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.6",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint": "@php vendor/bin/pint --test",
        "refactor": "@php vendor/bin/rector process --dry-run",
        "fix": [
            "@php vendor/bin/rector process",
            "@php vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [{
        "name": "flux-pro",
        "type": "composer",
        "url": "https://composer.fluxui.dev"
    }]
}
